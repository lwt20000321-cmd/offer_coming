# 前端请求走相对路径，由 Vite 把 /api 代理到后端，不要写成完整后端 URL
VITE_API_BASE_URL=/api
# 仅给 Vite 代理使用；Agent 开发默认 8099，用户门禁改为 http://localhost:8003
VITE_BACKEND_PROXY_TARGET=http://localhost:8099
# 真实验收必须为 false（或省略），请求打到 8099/8003。true 时走 frontend/src/mocks/，不发真实后端
VITE_USE_MOCK=false
# 求职者百炼 Key 只从页面粘贴进 API-001/002；不要在前端环境写任何 Key
