# 调试与文档
debug=true
# 会话哈希盐（必填，本地请换成随机串，不要提交真实值）
secret_key=change-me
# 监听地址
host=127.0.0.1
# Agent 开发端口
port=8099
# CORS：Agent 5199 与门禁 5175
cors_origins=["http://localhost:5199","http://127.0.0.1:5199","http://localhost:5175","http://127.0.0.1:5175"]
# SQLite（相对 backend/ 解析为绝对路径）
database_path=data/offer_coming.db
# 简历与面经原件根目录
upload_dir=data/uploads
# 简历上传上限（字节）
resume_max_bytes=10485760
# 对话内面经文件上限（字节）
knowledge_max_bytes=10485760
# 接续令牌有效天数
session_ttl_days=30
# 业务日与调度时区
timezone=Asia/Shanghai
# 百炼 OpenAI 兼容 BASE
llm_base_url=https://dashscope.aliyuncs.com/compatible-mode/v1
# 百炼 API Key：仅非求职者路径（本地探活脚本等）。禁止作为求职者对话/出题/催促/检索/Key 探测的 Bearer，不给求职者代付。求职者 Key 由用户提交并加密保存。敏感，只在本地 .env 填写，此处留空。
llm_api_key=
# pytest/本地跳过 HTTP 的 Mock 开关。仅在已有求职者 Key 占位串时跳过真实请求，仍不得用运营 Key 代打百炼。
llm_allow_mock=false
# 五套模型必须互不相同；缺一或相同则启动失败。旧 llm_model 已废弃。
llm_orchestrator_model=qwen-plus
llm_nudge_model=qwen-flash
llm_interview_model=qwen-max
llm_knowledge_model=qwen-plus-latest
llm_counseling_model=qwen-turbo
# 工具轮关闭思考
llm_enable_thinking=false
# 主体对外回复长度（token）；闲聊落库后再按字符封顶。当日五题/点评不套字符封顶
llm_reply_max_tokens=2048
llm_reply_max_chars=500
# 主体/子 Agent 带上的最近对话条数；每条再按字符截断
llm_history_max_messages=16
llm_history_max_chars=400
# 百炼读超时（秒）
llm_timeout_seconds=90
# 连接超时（秒）
llm_connect_timeout_seconds=10
# 429/5xx 重试次数
llm_max_retries=2
# 单模型循环上限
agent_max_steps=8
# 单岗最多入库检索条数
knowledge_search_max_items=3
# 拉取 JD 超时（秒）
jd_fetch_timeout_seconds=15
# 拉取 JD 的 User-Agent
jd_fetch_user_agent=offer_coming/1.0
# SMTP 催促邮件（D-003-A）。齐全需 host/port/user/password/from；true=STARTTLS，false=SSL。未配置或失败不假装已发送。密码只填本地 .env，此处留空。
smtp_host=
# STARTTLS 常用 587，SSL 常用 465
smtp_port=
smtp_user=
smtp_password=
smtp_from=
smtp_use_tls=true
